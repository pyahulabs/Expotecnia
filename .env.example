# Copiá este archivo como ".env" y pegá los valores de tu proyecto de Firebase
# (Consola de Firebase → Configuración del proyecto → Tus apps → SDK de Firebase).
# Si dejás los valores vacíos, la app funciona en "modo local" (datos en el navegador).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
